---
import Layout from '../../../layouts/Layout.astro';
import Section from '../../../components/Section.astro';
import { loadAllGuides, altUrl, LANGS, type Guide, type Sub, type Lang } from '../../../lib/guide';

export async function getStaticPaths() {
  const guides = loadAllGuides();
  return LANGS.flatMap(lang =>
    guides[lang].chapters.flatMap(ch =>
      ch.subs.map(sub => ({
        params: { lang, chapter: ch.slug, sub: sub.slug },
        props: { guide: guides[lang], sub, lang, alt: Object.fromEntries(LANGS.filter(l => l !== lang).map(l => [l, altUrl(guides, sub, l)])) }
      }))
    )
  );
}

interface Props { guide: Guide; sub: Sub; lang: Lang; alt: Partial<Record<Lang, string>>; }
const { guide, sub, lang, alt } = Astro.props;
---
<Layout guide={guide} current={sub} lang={lang} alt={alt} title={`${sub.chapterNum} ${sub.chapterName} / ${sub.name}`}>
  <header class="page-head">
    <h1 class="page-head__title t-display">{sub.name}</h1>
  </header>

  <div class="sections">
    {sub.sections.map(s => <Section section={s} />)}
  </div>

  {sub.next && (
    <a class="next" href={sub.next.url}>
      <span class="next__label t-label">Next</span>
      <span class="next__title t-heading">{sub.next.chapterName} / {sub.next.name}{' '}<svg class="next__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7" /></svg></span>
    </a>
  )}
</Layout>
