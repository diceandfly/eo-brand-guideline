---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import { loadGuide, type Guide, type Sub } from '../../lib/guide';

export async function getStaticPaths() {
  const guide = loadGuide();
  return guide.chapters.flatMap(ch =>
    ch.subs.map(sub => ({ params: { chapter: ch.slug, sub: sub.slug }, props: { guide, sub } }))
  );
}

interface Props { guide: Guide; sub: Sub; }
const { guide, sub } = Astro.props;
---
<Layout guide={guide} current={sub} title={`${sub.chapterNum} ${sub.chapterName} / ${sub.name}`}>
  <header class="page-head">
    <h1 class="page-head__title t-display">{sub.name}</h1>
  </header>

  <div class="sections">
    {sub.sections.map(s => <Section section={s} />)}
  </div>

  {sub.next && (
    <a class="next" href={sub.next.url}>
      <span class="next__label t-label">Next</span>
      <span class="next__title t-heading">{sub.next.chapterNum} {sub.next.chapterName} / {sub.next.name}</span>
    </a>
  )}
</Layout>
