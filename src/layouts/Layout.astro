---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import Sidebar from '../components/Sidebar.astro';
import Logo from '../components/Logo.astro';
import { UI_TEXT, type Guide, type Sub, type Lang } from '../lib/guide';

interface Props { guide: Guide; current?: Sub; lang: Lang; alt: Partial<Record<Lang, string>>; title: string; }
const { guide, current, lang, alt, title } = Astro.props;
const ui = UI_TEXT[lang];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · EO Brand Guidelines</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- 매 페이지에서 쓰는 웹폰트를 CSS 파싱 전에 미리 받습니다 (페이지 전환 시 시스템 폰트가 스치는 것 방지).
         파일명은 fonts.css 와 같아야 합니다. -->
    <link rel="preload" href="/fonts/founders-grotesk-light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/founders-grotesk-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/founders-grotesk-medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/founders-grotesk-mono-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/founders-grotesk-mono-medium.woff2" as="font" type="font/woff2" crossorigin />
    <!-- 한글 본문 서체 (body 레벨 전용). 오프라인이면 tokens.css 의 --font-ko 폴백(Apple SD Gothic Neo)으로 렌더됩니다. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" crossorigin="anonymous" />
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <button class="topbar__menu" type="button" aria-label={ui.openToc} aria-expanded="false" data-nav-toggle>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </button>
        <a class="topbar__logo" href={`/${lang}`}><Logo /></a>
      </header>

      <Sidebar guide={guide} current={current} lang={lang} alt={alt} />

      <!-- 스무스 스크롤 래퍼. 고정 요소(목차, 상단 바, 라이트박스)는 이 밖에 둡니다. -->
      <div id="smooth-wrapper">
        <div id="smooth-content">
          <main class="main">
            <div class="main__inner">
              <slot />
            </div>
          </main>
        </div>
      </div>
    </div>

    <!-- 이미지 확대 보기. 클릭하면 열리고, 아무 곳이나 클릭하거나 Esc 로 닫힘 -->
    <div class="lightbox" data-lightbox aria-hidden="true" role="dialog" aria-modal="true" aria-label={ui.lightbox} tabindex="-1">
      <img class="lightbox__img" alt="" />
      <span class="strike lightbox__strike" aria-hidden="true"></span>
    </div>

    <script>
      import '../lib/motion';
    </script>
    <script>
      // 값 복사 (컬러 카드의 값 · 본문 컬러 칩). 버튼에 is-copied 를 잠깐 붙여 Copy → Copied 로 바꿉니다.
      const raw = getComputedStyle(document.documentElement).getPropertyValue('--swatch-copied-dur').trim();
      const copiedMs = raw.endsWith('ms') ? parseFloat(raw) : (parseFloat(raw) || 1.2) * 1000;
      const write = async (text: string) => {
        try { await navigator.clipboard.writeText(text); return true; }
        catch {                                                     // 클립보드 API 를 못 쓰는 환경 폴백
          const ta = Object.assign(document.createElement('textarea'), { value: text });
          ta.style.cssText = 'position:fixed;opacity:0';
          document.body.appendChild(ta); ta.select();
          const ok = document.execCommand('copy'); ta.remove(); return ok;
        }
      };
      const timers = new WeakMap<HTMLElement, number>();
      document.addEventListener('click', async e => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
        if (!btn) return;
        if (!(await write(btn.dataset.copy ?? ''))) return;
        btn.classList.add('is-copied');
        clearTimeout(timers.get(btn));
        timers.set(btn, window.setTimeout(() => btn.classList.remove('is-copied'), copiedMs));
      });
    </script>
    <script>
      // 모바일: 상단 바 버튼으로 목차 드로어 토글. 링크를 누르면 닫힘.
      // 닫힌 드로어는 화면 밖에 있어도 키보드 탭이 들어가지 않도록 inert. 기준 폭은 base.css 의 @media (max-width: 899px) 와 같게.
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const sidebar = document.querySelector<HTMLElement>('.sidebar');
      const desktop = window.matchMedia('(min-width: 900px)');
      const set = (open: boolean) => {
        root.classList.toggle('nav-open', open);
        btn?.setAttribute('aria-expanded', String(open));
        sidebar?.toggleAttribute('inert', !open && !desktop.matches);
        (window as any).__smoother?.paused(open);   // 드로어가 열린 동안 본문 스크롤 정지
      };
      btn?.addEventListener('click', () => set(!root.classList.contains('nav-open')));
      // 목차·검색 결과(나중에 만들어지는 것 포함)의 링크를 누르면 닫힘. 챕터는 목록만 접고 펴므로 제외
      sidebar?.addEventListener('click', e => { const a = (e.target as HTMLElement).closest('a'); if (a && !a.hasAttribute('data-chapter-toggle')) set(false); });
      desktop.addEventListener('change', () => set(false));
      set(false);
    </script>
  </body>
</html>
