---
import Logo from './Logo.astro';
import Search from './Search.astro';
import { LANGS, LANG_LABEL, type Guide, type Sub, type Lang } from '../lib/guide';

interface Props { guide: Guide; current?: Sub; lang: Lang; alt: Partial<Record<Lang, string>>; }
const { guide, current, lang, alt } = Astro.props;
---
<nav class="sidebar t-ui" aria-label="목차">
  <a class="nav__logo" href={`/${lang}`}><Logo /></a>
  <Search guide={guide} />
  <!-- 목록만 스크롤. 넘치면 위·아래가 마스크로 녹아듦 (아래 스크립트가 is-overflow / at-top / at-end 표시) -->
  <div class="nav__scroll" data-nav-scroll>
  <ul class="nav__chapters">
    {guide.chapters.map(ch => {
      const active = current?.chapterSlug === ch.slug;
      return (
        <li class:list={['nav__chapter', { 'is-active': active }]}>
          <a class="nav__chapter-link" href={ch.subs[0]?.url ?? `/${lang}`} aria-current={active ? 'true' : undefined}>
            <span class="nav__num">{ch.num}</span><span>{ch.name}</span>
          </a>
          <!-- 접고 펴는 묶음(nav__fold). 모든 목록을 미리 그려 두고 활성 쪽만 열어 둡니다. 클릭하면 아래 스크립트가 슬라이드로 전환 -->
          <div class:list={['nav__fold', { 'is-open': active }]} inert={!active}>
            <ul class="nav__subs">
              {ch.subs.map((s, si) => {
                const isCur = current?.url === s.url;
                return (
                  <li class:list={['nav__sub', { 'is-active': isCur }]} style={`--i: ${si}`}>
                    <a class="nav__sub-link" href={s.url} aria-current={isCur ? 'page' : undefined}>{s.name}</a>
                    {s.tocSections && s.navSections.length > 1 && (
                      <div class:list={['nav__fold', { 'is-open': isCur }]} inert={!isCur}>
                        <ul class="nav__sections" data-scrollspy={isCur ? '' : undefined}>
                          {s.navSections.map((ns, ni) => (
                            <li style={`--i: ${ni}`}><a class="nav__section-link" href={isCur ? `#${ns.id}` : `${s.url}#${ns.id}`} data-target={ns.id}>{ns.head}</a></li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        </li>
      );
    })}
  </ul>
  </div>

  <!-- 언어 전환. 같은 페이지의 다른 언어판으로 이동, 없으면 그 언어의 첫 페이지 -->
  <div class="nav__lang" aria-label="언어">
    {LANGS.map((l, i) => (
      <>
        {i > 0 && <span class="nav__lang-divider" aria-hidden="true">|</span>}
        {l === lang
          ? <span class="nav__lang-link is-active" aria-current="true">{LANG_LABEL[l]}</span>
          : <a class="nav__lang-link" href={alt[l] ?? `/${l}`} data-lang={l}>{LANG_LABEL[l]}</a>}
      </>
    ))}
  </div>
</nav>

<script>
  // 목차 슬라이드: 다른 페이지로 가는 챕터·서브챕터 링크를 누르면, 열린 목록은 접고 갈 곳의 목록은 펼칩니다.
  // 본문이 사라지는 동안(motion.ts 페이지 전환) 슬라이드가 끝나고, 새 페이지는 같은 모양으로 열리므로 끊김이 없습니다.
  const sidebar = document.querySelector<HTMLElement>('.sidebar');
  const setFold = (fold: Element | null | undefined, open: boolean) => {
    if (!fold) return;
    fold.classList.toggle('is-open', open);
    if (open) fold.removeAttribute('inert'); else fold.setAttribute('inert', '');
  };
  sidebar?.addEventListener('click', e => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.nav__chapter-link, .nav__sub-link');
    if (!a || new URL(a.href).pathname === location.pathname) return;
    const chapter = a.closest('.nav__chapter');
    const sub = a.classList.contains('nav__sub-link') ? a.closest('.nav__sub') : chapter?.querySelector('.nav__sub');
    const keep = new Set([chapter?.querySelector(':scope > .nav__fold'), sub?.querySelector(':scope > .nav__fold')]);
    sidebar.querySelectorAll('.nav__fold.is-open').forEach(f => { if (!keep.has(f)) setFold(f, false); });
    keep.forEach(f => setFold(f, true));
    sidebar.querySelectorAll('.nav__chapter.is-active, .nav__sub.is-active').forEach(el => el.classList.remove('is-active'));
    chapter?.classList.add('is-active');
    sub?.classList.add('is-active');
  });

  // 목록 스크롤: 넘치는지, 맨 위/맨 아래인지 표시 → CSS 가 위·아래 페이드(마스크)를 켜고 끔.
  // 페이지를 옮겨도 목록의 스크롤 위치를 유지하고, 활성 항목이 안 보이면 보이는 곳까지만 스크롤.
  const scroller = document.querySelector<HTMLElement>('[data-nav-scroll]');
  if (scroller) {
    const KEY = 'guide-nav-scroll';
    const sync = () => {
      const max = scroller.scrollHeight - scroller.clientHeight;
      scroller.classList.toggle('is-overflow', max > 1);
      scroller.classList.toggle('at-top', scroller.scrollTop <= 1);
      scroller.classList.toggle('at-end', scroller.scrollTop >= max - 1);
    };
    try { const y = Number(sessionStorage.getItem(KEY)); if (y) scroller.scrollTop = y; } catch {}
    const cur = scroller.querySelector<HTMLElement>('.nav__sub.is-active > .nav__sub-link');
    if (cur) {
      const r = cur.getBoundingClientRect(), b = scroller.getBoundingClientRect();
      if (r.top < b.top || r.bottom > b.bottom) cur.scrollIntoView({ block: 'nearest' });
    }
    sync();
    scroller.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(scroller.firstElementChild as Element);   // 목록이 펼쳐지고 접힐 때
    window.addEventListener('resize', sync);
    window.addEventListener('pagehide', () => { try { sessionStorage.setItem(KEY, String(scroller.scrollTop)); } catch {} });
  }

  // 선택한 언어를 기억해 두면 루트(/)로 들어올 때 그 언어로 보냅니다.
  document.querySelectorAll<HTMLAnchorElement>('.nav__lang-link[data-lang]').forEach(a =>
    a.addEventListener('click', () => { try { localStorage.setItem('guide-lang', a.dataset.lang!); } catch {} })
  );
  try { localStorage.setItem('guide-lang', document.documentElement.lang); } catch {}
</script>
