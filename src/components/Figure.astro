---
/**
 * 이미지 1장. 파일이 있으면 <img>, 없으면 토큰 경로를 적은 플레이스홀더.
 * badge: do | dont  → 캡션 줄 맨 앞에 체크 / 엑스 아이콘 (레퍼런스와 같은 "아이콘 + 문구" 페어링)
 * caption 이 있으면 이미지 아래 캡션 (카드). 배지만 있고 캡션이 없으면 "Do" / "Don't" 를 기본 문구로 씁니다.
 */
import type { ImageItem } from '../lib/guide';

interface Props { item: ImageItem; ratio: string; }
const { item, ratio } = Astro.props;
const ratioLabel = ratio.replace(/\s/g, '').replace('var(--ratio-', '').replace(')', '');
const captionHtml = item.caption ?? (item.badge === 'do' ? 'Do' : item.badge === 'dont' ? 'Don’t' : '');
---
<figure class="fig" style={`--ratio: ${ratio}`}>
  <div class="fig__frame">
    {item.src
      ? <img src={item.src} alt={item.caption ? item.caption.replace(/<[^>]+>/g, '') : item.token} loading="lazy" />
      : <div class="fig__placeholder t-label">
          <span>assets/{item.path}</span>
          <span>{ratioLabel}</span>
        </div>}
    {item.strike && <span class="strike" aria-hidden="true" />}
  </div>
  {captionHtml && (
    <figcaption class="fig__caption t-body">
      {item.badge && (
        <span class:list={['fig__badge', `fig__badge--${item.badge}`]} aria-label={item.badge === 'do' ? 'Do' : "Don't"}>
          {item.badge === 'do'
            ? <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"><path d="M2.5 8.5l3.5 3.5L13.5 4" /></svg>
            : <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"><path d="M3 3l10 10M13 3L3 13" /></svg>}
        </span>
      )}
      <span class="fig__caption-text" set:html={captionHtml} />
    </figcaption>
  )}
</figure>
