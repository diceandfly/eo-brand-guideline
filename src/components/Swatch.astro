---
/**
 * 컬러 카드. 평소에는 색면과 이름만 보이고, 호버(또는 키보드 포커스)하면 스펙이 짧게 디졸브로 나타납니다.
 * 스펙은 아래에서 위로 투명해지는 그늘 위에 올라갑니다. 글자 색은 색면 밝기로 자동 선택: 흰 글자보다 검은 글자의 대비가
 * 높은 밝은 색면(swatch__card--light)은 검은 글자와 밝은 카드용 그늘(tokens.css 3-8 *-light)을 씁니다.
 * 비율: 기본은 tokens.css 의 --ratio-swatch, 섹션 헤드에 {ratio=3:4} 처럼 쓰면 그 섹션만 바뀝니다.
 * 패널 안의 숫자(메모 속 K45 같은 잉크 값 포함)는 하나씩 호버하면 하이라이트와 Copy 알약이 뜨고, 누르면 그 값만 복사됩니다.
 * 호버가 없는 터치 기기에서는 패널이 처음부터 열려 있습니다. 수치는 tokens.css 1-7 / 3-8 / 5. MOTION.
 */
import type { SwatchItem } from '../lib/guide';
import SwatchVal from './SwatchVal.astro';
interface Props { item: SwatchItem; ratio?: string; }
const { item, ratio } = Astro.props;
// WCAG 상대 휘도. 검정 대비가 흰색 대비보다 높으면 밝은 색면으로 봄 (Y > 약 0.18)
const lum = (hex: string) => {
  const c = hex.replace('#', '').match(/../g)!.map(h => parseInt(h, 16) / 255).map(v => v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const light = (lum(item.hex) + 0.05) / 0.05 > 1.05 / (lum(item.hex) + 0.05);
// 메모("or K45 only")에서 잉크 값(C·M·Y·K + 숫자)만 복사 가능한 값으로 떼어 냄
const noteParts = (note: string) => note.split(/\b([CMYK]\d{1,3})\b/).map((t, i) => ({ text: t, copy: i % 2 === 1 })).filter(p => p.text);
---
<div class="swatch">
  <div class:list={['swatch__card', { 'swatch__card--light': light }]} style={`--swatch-color: ${item.hex}${ratio ? `; --swatch-ratio: ${ratio}` : ''}`}>
    <dl class="swatch__panel t-body">
      {item.rows.map(r => (
        <div class="swatch__row">
          <dt class="swatch__label t-body">{r.label}</dt>
          <dd class="swatch__value t-body">
            {r.values.map(v => <SwatchVal value={v} label={r.label} />)}
            {r.note && (
              <span class="swatch__note">
                {noteParts(r.note).map(p => p.copy ? <SwatchVal value={p.text} label={r.label} /> : p.text)}
              </span>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="swatch__name t-body">{item.name}</div>
</div>

<script>
  // 값 복사. 버튼에 is-copied 를 잠깐 붙여 Copy → Copied 로 바꿉니다.
  const raw = getComputedStyle(document.documentElement).getPropertyValue('--swatch-copied-dur').trim();
  const copiedMs = raw.endsWith('ms') ? parseFloat(raw) : (parseFloat(raw) || 1.2) * 1000;
  const write = async (text: string) => {
    try { await navigator.clipboard.writeText(text); return true; }
    catch {                                                     // 클립보드 API 를 못 쓰는 환경 폴백
      const ta = Object.assign(document.createElement('textarea'), { value: text });
      ta.style.cssText = 'position:fixed;opacity:0';
      document.body.appendChild(ta); ta.select();
      const ok = document.execCommand('copy'); ta.remove(); return ok;
    }
  };
  const timers = new WeakMap<HTMLElement, number>();
  document.addEventListener('click', async e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.swatch__val');
    if (!btn) return;
    if (!(await write(btn.dataset.copy ?? ''))) return;
    btn.classList.add('is-copied');
    clearTimeout(timers.get(btn));
    timers.set(btn, window.setTimeout(() => btn.classList.remove('is-copied'), copiedMs));
  });
</script>
