---
/**
 * 목차 상단 검색창. 빌드 시 만든 섹션 색인(JSON)을 클라이언트에서 필터링합니다.
 * 헤드·서브헤드·본문·캡션을 대상으로 하며, 결과를 누르면 해당 섹션 앵커로 이동합니다.
 */
import { buildSearchIndex, type Guide } from '../lib/guide';
interface Props { guide: Guide; }
const { guide } = Astro.props;
const index = buildSearchIndex(guide);
---
<form class="search" role="search" data-search onsubmit="return false">
  <input class="search__input t-ui" type="search" placeholder="Search" aria-label="가이드라인 검색" autocomplete="off" spellcheck="false" data-search-input />
  <ul class="search__results t-ui" data-search-results></ul>
  <script type="application/json" data-search-index set:html={JSON.stringify(index)} />
</form>

<script>
  type Entry = { u: string; c: string; s: string; h: string; t: string; b: string };

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-search]')) {
    const input = form.querySelector<HTMLInputElement>('[data-search-input]')!;
    const list = form.querySelector<HTMLUListElement>('[data-search-results]')!;
    const index: Entry[] = JSON.parse(form.querySelector('[data-search-index]')!.textContent || '[]');
    const max = Number(getComputedStyle(document.documentElement).getPropertyValue('--search-results-max')) || 8;
    let active = -1;

    const open = (v: boolean) => { form.classList.toggle('is-open', v); if (!v) active = -1; };

    // 어디에서 걸렸는지: 3 제목(헤드·서브헤드) > 2 서브챕터 이름 > 1 본문
    const score = (e: Entry, q: string) => {
      const h = `${e.h} ${e.t}`.toLowerCase(), s = e.s.toLowerCase(), b = e.b.toLowerCase();
      if (h.includes(q)) return 3;
      if (s.includes(q)) return 2;
      if (b.includes(q)) return 1;
      return 0;
    };

    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    // 검색어를 <mark> 로 감쌈 (대소문자 무시)
    const mark = (text: string, q: string) => {
      const re = new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
      return esc(text).replace(re, m => `<mark class="search__mark">${m}</mark>`);
    };
    // 본문에서 걸린 경우: 검색어 몇 글자 앞(단어 경계)부터 한 줄 발췌. 넘치는 부분은 CSS 가 … 처리.
    // 패널이 좁으므로 검색어가 첫 줄 안에 보이도록 앞 여유를 짧게 둡니다.
    const BEFORE = 14;
    const snippet = (b: string, q: string) => {
      const i = b.toLowerCase().indexOf(q);
      if (i < 0) return '';
      let start = Math.max(0, i - BEFORE);
      if (start > 0) { const sp = b.lastIndexOf(' ', start); if (sp > 0 && start - sp < 10) start = sp + 1; }
      return (start > 0 ? '…' : '') + mark(b.slice(start, start + 160), q);
    };

    // 아이템 = 두 줄. 윗줄: 인용 텍스트(제목에서 걸리면 제목, 본문에서 걸리면 본문 발췌) 한 줄 말줄임.
    //               아랫줄: 경로(챕터 / 서브챕터 / 섹션 헤드), 줄바꿈 허용. 검색어는 어디든 강조.
    const render = () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { list.innerHTML = ''; open(false); return; }
      const hits = index
        .map(e => ({ e, n: score(e, q) }))
        .filter(x => x.n > 0)
        .sort((a, b) => b.n - a.n)
        .slice(0, max);
      list.innerHTML = hits.length
        ? hits.map(({ e, n }) => {
            const crumb = `${e.c} / ${e.s} / ${e.h}`;
            // 인용 줄: 제목(헤드·서브헤드)이나 서브챕터 이름에서 걸리면 "헤드 — 서브헤드", 본문에서 걸리면 본문 발췌
            const title = e.t !== e.h ? `${e.h} — ${e.t}` : e.h;
            const quote = n === 1 ? snippet(e.b, q) : mark(title, q);
            return `<li class="search__item"><a href="${e.u}" title="${esc(e.t)} — ${esc(crumb)}">`
              + `<span class="search__quote">${quote}</span>`
              + `<span class="search__crumb t-label">${mark(crumb, q)}</span></a></li>`;
          }).join('')
        : `<li class="search__empty">No results</li>`;
      open(true);
    };

    const setActive = (i: number) => {
      const items = [...list.querySelectorAll('.search__item')];
      if (!items.length) return;
      active = (i + items.length) % items.length;
      items.forEach((el, k) => el.classList.toggle('is-active', k === active));
      items[active].scrollIntoView({ block: 'nearest' });
    };

    input.addEventListener('input', render);
    input.addEventListener('focus', () => { if (input.value.trim()) open(true); });
    input.addEventListener('keydown', e => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') {
        const a = list.querySelector<HTMLAnchorElement>(active >= 0 ? '.search__item.is-active a' : '.search__item a');
        if (a) { e.preventDefault(); location.href = a.href; }
      }
      else if (e.key === 'Escape') { input.value = ''; render(); input.blur(); }
    });
    document.addEventListener('click', e => { if (!form.contains(e.target as Node)) open(false); });

    // 같은 페이지 안의 앵커로 이동할 때는 결과를 닫고 스크롤만
    list.addEventListener('click', e => {
      const a = (e.target as HTMLElement).closest('a');
      if (!a) return;
      const url = new URL(a.href);
      if (url.pathname === location.pathname && url.hash) {
        e.preventDefault();
        document.getElementById(url.hash.slice(1))?.scrollIntoView({ block: 'start' });
        history.replaceState(null, '', url.hash);
      }
      open(false);
      document.documentElement.classList.remove('nav-open');
    });
  }
</script>
