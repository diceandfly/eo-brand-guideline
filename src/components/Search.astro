---
/**
 * 목차 상단 검색창. 빌드 시 만든 섹션 색인(JSON)을 클라이언트에서 필터링합니다.
 * 헤드·서브헤드·본문·캡션을 대상으로 하며, 결과를 누르면 해당 섹션 앵커로 이동합니다.
 */
import { buildSearchIndex, UI_TEXT, type Guide } from '../lib/guide';
interface Props { guide: Guide; }
const { guide } = Astro.props;
const index = buildSearchIndex(guide);
const ui = UI_TEXT[guide.lang];
const found = { zero: ui.found(0), many: ui.found(999).replace('999', '{n}') };   // 결과 개수 알림 문구 (클라이언트에서 {n} 치환)
---
<form class="search" role="search" data-search onsubmit="return false" data-found-zero={found.zero} data-found-many={found.many}>
  <input class="search__input t-ui" type="search" placeholder="Search" aria-label={ui.search} autocomplete="off" spellcheck="false"
    role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-results" data-search-input />
  <button class="search__clear" type="button" aria-label={ui.clear} hidden data-search-clear>
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
  </button>
  <ul class="search__results t-ui" id="search-results" role="listbox" aria-label={ui.results} data-search-results></ul>
  <p class="sr-only" aria-live="polite" data-search-status></p>
  <script type="application/json" data-search-index set:html={JSON.stringify(index)} />
</form>

<script>
  import type { SearchEntry as Entry } from '../lib/guide';

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-search]')) {
    const input = form.querySelector<HTMLInputElement>('[data-search-input]')!;
    const clear = form.querySelector<HTMLButtonElement>('[data-search-clear]')!;
    const list = form.querySelector<HTMLUListElement>('[data-search-results]')!;
    const status = form.querySelector<HTMLElement>('[data-search-status]')!;
    const index: Entry[] = JSON.parse(form.querySelector('[data-search-index]')!.textContent || '[]');
    let active = -1;

    const open = (v: boolean) => {
      form.classList.toggle('is-open', v);
      input.setAttribute('aria-expanded', String(v));
      if (!v) { active = -1; input.removeAttribute('aria-activedescendant'); }
    };
    // 결과 개수를 화면낭독기에 알림 (화면에는 보이지 않음)
    const announce = (n: number) => { status.textContent = n ? form.dataset.foundMany!.replace('{n}', String(n)) : form.dataset.foundZero!; };

    // 어디에서 걸렸는지: 3 제목(헤드·서브헤드) > 2 본문 > 1 서브챕터·챕터 이름만
    const score = (e: Entry, q: string) => {
      const h = `${e.h} ${e.t}`.toLowerCase(), s = `${e.c} ${e.s}`.toLowerCase(), b = e.b.toLowerCase();
      if (h.includes(q)) return 3;
      if (b.includes(q)) return 2;
      if (s.includes(q)) return 1;
      return 0;
    };

    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    // 검색어를 <mark> 로 감쌈 (대소문자 무시)
    const mark = (text: string, q: string) => {
      const re = new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
      return esc(text).replace(re, m => `<mark class="search__mark">${m}</mark>`);
    };
    // 본문에서 걸린 경우: 검색어 몇 글자 앞(단어 경계)부터 한 줄 발췌. 넘치는 부분은 CSS 가 … 처리.
    // 패널이 좁으므로 검색어가 첫 줄 안에 보이도록 앞 여유를 짧게 둡니다.
    const BEFORE = 14;
    const snippet = (b: string, q: string) => {
      const i = b.toLowerCase().indexOf(q);
      if (i < 0) return '';
      let start = Math.max(0, i - BEFORE);
      if (start > 0) { const sp = b.lastIndexOf(' ', start); if (sp > 0 && start - sp < 10) start = sp + 1; }
      return (start > 0 ? '…' : '') + mark(b.slice(start, start + 160), q);
    };

    // 아이템 = 두 줄. 윗줄: 인용 텍스트(제목에서 걸리면 제목, 본문에서 걸리면 본문 발췌) 한 줄 말줄임.
    //               아랫줄: 경로(챕터 / 서브챕터 / 섹션 헤드), 줄바꿈 허용. 검색어는 어디든 강조.
    const render = () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { list.innerHTML = ''; status.textContent = ''; open(false); return; }
      const hits = index
        .map(e => ({ e, n: score(e, q) }))
        .filter(x => x.n > 0)
        .sort((a, b) => b.n - a.n);   // 개수 제한 없음. 패널이 스크롤됨
      list.innerHTML = hits.length
        ? hits.map(({ e, n }, k) => {
            const crumb = `${e.c} / ${e.s} / ${e.h}`;
            // 인용 줄: 제목에 검색어가 있으면 "헤드 — 서브헤드"(강조), 본문에 있으면 본문 발췌(강조),
            //          챕터·서브챕터 이름에만 있으면 제목 그대로 (검색어는 경로에 보임)
            const title = e.t !== e.h ? `${e.h} — ${e.t}` : e.h;
            const quote = n === 3 ? mark(title, q) : n === 2 ? snippet(e.b, q) : esc(title);
            return `<li class="search__item" role="option" id="search-opt-${k}" aria-selected="false"><a href="${e.u}" tabindex="-1" title="${esc(e.t)} — ${esc(crumb)}">`
              + `<span class="search__quote">${quote}</span>`
              + `<span class="search__crumb t-label">${esc(crumb)}</span></a></li>`;   // 경로는 강조하지 않음
          }).join('')
        : `<li class="search__empty" role="option" aria-disabled="true">No results</li>`;
      input.removeAttribute('aria-activedescendant');
      announce(hits.length);
      open(true);
    };

    const setActive = (i: number) => {
      const items = [...list.querySelectorAll('.search__item')];
      if (!items.length) return;
      active = (i + items.length) % items.length;
      items.forEach((el, k) => { el.classList.toggle('is-active', k === active); el.setAttribute('aria-selected', String(k === active)); });
      input.setAttribute('aria-activedescendant', items[active].id);   // 포커스는 입력창에 둔 채 고른 항목을 화면낭독기에 전달
      items[active].scrollIntoView({ block: 'nearest' });
    };

    // 입력이 있을 때만 × 버튼 표시. 누르면 비우고 다시 입력 상태로
    const syncClear = () => { clear.hidden = !input.value; };
    input.addEventListener('input', () => { syncClear(); render(); });
    clear.addEventListener('click', () => { input.value = ''; syncClear(); render(); input.focus(); });
    syncClear();
    input.addEventListener('focus', () => { if (input.value.trim()) open(true); });
    input.addEventListener('keydown', e => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') {
        const a = list.querySelector<HTMLAnchorElement>(active >= 0 ? '.search__item.is-active a' : '.search__item a');
        if (a) { e.preventDefault(); a.click(); }   // 클릭과 같은 경로(같은 페이지면 스크롤, 다른 페이지면 전환 디졸브)
      }
      else if (e.key === 'Escape') { input.value = ''; syncClear(); render(); input.blur(); }
    });
    document.addEventListener('click', e => { if (!form.contains(e.target as Node)) open(false); });

    // 같은 페이지 안의 앵커로 이동할 때는 결과를 닫고 스크롤만
    list.addEventListener('click', e => {
      const a = (e.target as HTMLElement).closest('a');
      if (!a) return;
      const url = new URL(a.href);
      if (url.pathname === location.pathname && url.hash) {
        e.preventDefault();
        const id = decodeURIComponent(url.hash.slice(1));
        const go = (window as any).__scrollToId as ((id: string) => boolean) | undefined;   // motion.ts (스무스 스크롤)
        if (go) go(id); else document.getElementById(id)?.scrollIntoView({ block: 'start' });
        history.replaceState(null, '', url.hash);
      }
      open(false);
      document.documentElement.classList.remove('nav-open');
    });
  }
</script>
