---
/**
 * 섹션 = 텍스트 블록(헤드 / 서브헤드 / 본문) + 미디어 슬롯.
 * 미디어 슬롯의 아이템 수와 layout 속성에 따라 basic / text / wide / half / grid-N 으로 렌더됩니다.
 * wide 는 이미지가 여러 개면 전폭으로 세로로 쌓습니다.
 */
import Figure from './Figure.astro';
import Swatch from './Swatch.astro';
import type { Section } from '../lib/guide';

interface Props { section: Section; eagerFrom?: number; eagerCount?: number; }   // eager*: 페이지 기준 이미지 순번 → 앞쪽 몇 장만 eager 로드 ([sub].astro)
const { section: s, eagerFrom = 0, eagerCount = 0 } = Astro.props;
const eager = (i: number) => eagerFrom + i < eagerCount;

const isGrid = s.layout.startsWith('grid-');
const n = isGrid ? Number(s.layout.split('-')[1]) : 1;
const kind = isGrid ? 'grid' : s.layout;
const defaultRatio = isGrid ? 'var(--ratio-card)' : s.layout === 'wide' ? 'var(--ratio-wide)' : 'var(--ratio-basic)';
const allDoDont = s.items.length > 0 && s.items.every(it => it.kind === 'image' && it.badge);
const ratio = s.ratio ?? (allDoDont ? 'var(--ratio-dodont)' : defaultRatio);   // Do/Don't 시리즈는 --ratio-dodont ({ratio=} 가 있으면 그 값)
// wide 는 아이템을 모두 세로로 쌓고, basic / half 는 첫 아이템 하나만 보여 줌. 나머지가 조용히 사라지지 않도록 빌드 로그에 알림
const stacked = s.layout === 'wide' ? s.items : s.items.slice(0, 1);
if (!isGrid && s.items.length > stacked.length) console.warn(`[guide] "${s.head}${s.subhead ? ' / ' + s.subhead : ''}" (${s.layout}) 섹션의 이미지 ${s.items.length}개 중 첫 번째만 표시됩니다. 모두 보이려면 헤드에 {layout=grid-2|3|4}`);
---
<section class:list={['sec', `sec--${kind}`]} id={s.id} data-section>
  <div class="sec__text">
    <h2 class="sec__head t-heading">{s.head}</h2>
    {s.subhead && <h3 class="sec__subhead t-heading t-subhead">{s.subhead}</h3>}
    {s.bodyHtml && <div class="sec__body t-body" set:html={s.bodyHtml} />}
  </div>

  {!isGrid && stacked.length > 0 && (
    <div class="sec__media">
      {stacked.map((it, i) => it.kind === 'image'
        ? <Figure item={it} ratio={ratio} zoom={s.zoom} label={s.subhead ?? s.head} eager={eager(i)} />
        : <Swatch item={it} ratio={s.ratio} />)}
    </div>
  )}

  {isGrid && (
    <div class:list={['sec__grid', { 'sec__grid--swatch': s.items.some(it => it.kind === 'swatch') }]} style={`--n: ${n}`} data-n={n}>
      {s.items.map((it, i) => it.kind === 'image' ? <Figure item={it} ratio={ratio} zoom={s.zoom} label={s.subhead ?? s.head} eager={eager(i)} /> : <Swatch item={it} ratio={s.ratio} />)}
    </div>
  )}
</section>
